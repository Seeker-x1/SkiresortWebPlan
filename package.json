{
  "name": "skiresort-web-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview:site": "node scripts/build-static-preview.mjs && node scripts/build-evaluation-html.mjs",
    "preview:evaluation": "node scripts/build-evaluation-html.mjs",
    "preview:static": "node scripts/build-static-preview.mjs && node scripts/build-evaluation-html.mjs && npx --yes serve public -p 5500",
    "preview:map": "node resorts/Sichinohe-CyoueiSki/scripts/build-map-preview.mjs && node resorts/Sichinohe-CyoueiSki/scripts/build-calibration-qa.mjs && node scripts/build-static-preview.mjs && node scripts/build-evaluation-html.mjs",
    "lp:batch-status": "node scripts/lp-factory/batch-status.mjs",
    "lp:research-prompt": "node scripts/lp-factory/build-deep-research-prompt.mjs",
    "lp:cursor-handoff": "node scripts/lp-factory/cursor-handoff.mjs",
    "lp:batch-update": "node scripts/lp-factory/batch-update.mjs",
    "lp:import-batch": "node scripts/lp-factory/import-batch-from-gemini.mjs",
    "lp:sales-proposal": "node scripts/lp-factory/build-sales-proposal.mjs",
    "lp:detect-inbox": "node scripts/lp-factory/detect-inbox-reports.mjs",
    "lp:deep-research": "node scripts/lp-factory/run-deep-research.mjs",
    "lp:import-report": "node scripts/lp-factory/import-gem-report.mjs",
    "lp:auto": "node scripts/lp-factory/run-lp-auto.mjs",
    "lp:ship": "node scripts/lp-factory/ship-lp.mjs",
    "map:research": "node scripts/map-factory/research.mjs",
    "map:validate": "node scripts/map-factory/validate.mjs",
    "map:extract-lines": "node scripts/map-factory/extract-line-candidates.mjs",
    "map:promote": "node scripts/map-factory/promote-hitboxes.mjs",
    "map:validate-mode": "node docs/mock-assets/scripts/validate-map-mode.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "next": "16.2.12",
    "next-intl": "^4.13.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "js-yaml": "4.3.0",
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6",
    "minimatch@^3": "10.2.6",
    "@babel/core": "7.29.7",
    "undici": "6.28.0"
  }
}
